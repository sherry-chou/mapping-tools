            "interventions": [
                {
                    "type": "DRUG",
                    "name": "RZ-001",
                    "description": "Recombinant adenovirus harboring the modified ribozyme construct with HSV-tk as a therapeutic transgene",
                    "armGroupLabels": [
                        "Part 1 Cohort 1",
                        "Part 1 Cohort 2",
                        "Part 1 Cohort 3",
                        "Part 1 Cohort 4",
                        "Part 1 Cohort 5",
                        "Part 2"
                    ],
                    "otherNames": [
                        "Ad-ECRT-122T"
                    ]
                },
                {
                    "type": "COMBINATION_PRODUCT",
                    "name": "VGCV",
                    "description": "VGCV, used in a subject after RZ-001 administration, is a nucleoside analog that is metabolized by HSV-tk and other cellular kinases to form the cytotoxic nucleotide analog ganciclovir triphosphate. An approved oral VGCV will be used in the proposed clinical study of RZ-001.",
                    "armGroupLabels": [
                        "Part 1 Cohort 1",
                        "Part 1 Cohort 2",
